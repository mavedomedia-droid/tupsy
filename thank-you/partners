<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Thank you — Tupsy</title>
<meta name="description" content="Thanks for telling us about your project. We'll be in touch soon.">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#102C24">

<link rel="icon" type="image/svg+xml" href="https://tupsy.netlify.app/assets/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="https://tupsy.netlify.app/assets/favicon-32.png">
<link rel="apple-touch-icon" href="https://tupsy.netlify.app/assets/apple-touch-icon.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
:root{
  --forest:#102C24;
  --forest-soft:#16382D;
  --rose:#E8436B;
  --rose-dark:#C93359;
  --blush:#F4DAD3;
  --ivory:#F7F2E9;
  --charcoal:#252627;
  --edge-light:rgba(247,242,233,.16);
  --radius:8px;
  --display:'Archivo','Helvetica Neue',Arial,sans-serif;
  --body:'Inter',system-ui,-apple-system,sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;background:var(--forest);color:var(--ivory);
  font-family:var(--body);font-size:16px;line-height:1.58;
  -webkit-font-smoothing:antialiased;
  min-height:100dvh;display:flex;flex-direction:column;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
::selection{background:var(--rose);color:#fff}
:focus-visible{outline:2px solid var(--rose);outline-offset:3px;border-radius:var(--radius)}

.top{padding:20px 0;border-bottom:1px solid var(--edge-light)}
.top__inner{
  width:min(1280px,100% - 44px);margin-inline:auto;
  display:flex;align-items:center;justify-content:space-between;gap:24px;
}
.logo{display:inline-flex;align-items:center}
.logo img{height:26px;width:auto;display:block}
.top__home{
  font-family:var(--display);font-weight:600;font-size:.7rem;
  letter-spacing:.12em;text-transform:uppercase;opacity:.6;
  transition:opacity .18s ease;
}
.top__home:hover{opacity:1}

.main{flex:1;display:grid;place-items:center;padding:clamp(44px,6vw,80px) 0}
.card{width:min(660px,100% - 48px);margin-inline:auto;text-align:center}

.mark{
  width:80px;height:80px;border-radius:50%;background:var(--rose);color:#fff;
  display:grid;place-items:center;margin:0 auto 30px;
  animation:pop .5s cubic-bezier(.2,.8,.3,1.2) both;
}
@keyframes pop{from{opacity:0;transform:scale(.7)}}

.eyebrow{
  font-family:var(--display);font-weight:600;font-size:.7rem;
  letter-spacing:.22em;text-transform:uppercase;color:var(--rose);margin:0 0 18px;
}

.h1{
  font-family:var(--display);font-weight:800;
  font-size:clamp(2.2rem,5.6vw,3.8rem);
  letter-spacing:-.025em;line-height:1.02;margin:0 0 22px;
}

.lede{
  font-size:clamp(.95rem,1.3vw,1.08rem);line-height:1.55;opacity:.78;
  max-width:46ch;margin:0 auto 36px;
}

.ref{
  display:inline-flex;align-items:center;gap:10px;
  padding:10px 18px;border:1px solid var(--edge-light);border-radius:999px;
  font-family:var(--display);font-weight:600;font-size:.8rem;
  letter-spacing:.08em;margin:0 0 34px;opacity:.85;
}
.ref strong{color:var(--rose);letter-spacing:.1em;font-family:'Courier New',monospace}
.ref[hidden]{display:none}

.next{
  list-style:none;margin:0 auto 38px;padding:0;max-width:480px;
  text-align:left;border-top:1px solid var(--edge-light);
}
.next li{
  display:grid;grid-template-columns:40px 1fr;gap:14px;
  padding:16px 0;border-bottom:1px solid var(--edge-light);
  font-size:.92rem;line-height:1.5;opacity:.85;
}
.next b{
  font-family:var(--display);font-weight:700;font-size:.66rem;
  letter-spacing:.16em;color:var(--rose);padding-top:.42em;
}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  padding:16px 28px;border:1px solid transparent;border-radius:var(--radius);
  font-family:var(--display);font-weight:700;font-size:.74rem;
  letter-spacing:.12em;text-transform:uppercase;cursor:pointer;
  transition:background .18s ease,color .18s ease,transform .18s ease;
}
.btn:active{transform:translateY(1px)}
.btn--rose{background:var(--rose);color:#fff}
.btn--rose:hover{background:var(--rose-dark)}
.btn .arw{transition:transform .2s ease}
.btn:hover .arw{transform:translateX(3px)}

.help{
  margin:32px 0 0;font-size:.82rem;opacity:.55;line-height:1.55;
}
.help a{
  border-bottom:1px solid rgba(247,242,233,.35);padding-bottom:1px;
  transition:border-color .18s ease,opacity .18s ease;
}
.help a:hover{border-color:var(--rose);opacity:1}

.foot{
  padding:20px 0;border-top:1px solid var(--edge-light);
  font-size:.72rem;letter-spacing:.06em;opacity:.4;
}
.foot__inner{
  width:min(1280px,100% - 44px);margin-inline:auto;
  display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;
}

@media (max-width:520px){
  .top__home{display:none}
  .card{width:calc(100% - 40px)}
  .next li{grid-template-columns:34px 1fr;gap:10px}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms !important;transition-duration:.001ms !important}
}
</style>
</head>
<body>

<header class="top">
  <div class="top__inner">
    <a href="/" class="logo" aria-label="Tupsy — home">
      <img src="https://tupsy.netlify.app/assets/tupsy-logo-light.svg"
           alt="Tupsy" width="140" height="26">
    </a>
    <a href="/" class="top__home">← Back to home</a>
  </div>
</header>

<main class="main">
  <div class="card">
    <div class="mark" aria-hidden="true">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
        <path d="M4 12.5l5.2 5.2L20 6.8"
              stroke="currentColor" stroke-width="2.4"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <p class="eyebrow" id="eyebrow">Project received</p>

    <h1 class="h1" id="title">We've got it.</h1>

    <p class="lede" id="lede">
      Thanks for telling us what you're thinking. We'll review the details and
      get back to you to talk it through.
    </p>

    <div class="ref" id="ref" hidden>
      Reference <strong id="ref-value">—</strong>
    </div>

    <ul class="next" id="next-list">
      <li>
        <b>01</b>
        <span>We read through everything you sent us.</span>
      </li>
      <li>
        <b>02</b>
        <span>We reach out on WhatsApp or email to ask anything we need.</span>
      </li>
      <li>
        <b>03</b>
        <span>We set up a proper conversation about the idea, materials and timeline.</span>
      </li>
    </ul>

    <a class="btn btn--rose" href="/">
      Back to weartupsy.com <span class="arw" aria-hidden="true">→</span>
    </a>

    <p class="help" id="help">
      In a hurry? Message us on
      <a href="#">WhatsApp</a> or
      <a href="#">Instagram</a>.
    </p>
  </div>
</main>

<footer class="foot">
  <div class="foot__inner">
    <span>© <span id="year"></span> Tupsy. All rights reserved.</span>
    <span>You bring the idea. We help make it real.</span>
  </div>
</footer>

<script>
(function () {
  'use strict';

  var params = new URLSearchParams(window.location.search);
  var type = (params.get('type') || '').toLowerCase();

  var COPY = {
    project: {
      title:     "Thank you — Tupsy",
      eyebrow:   'Project received',
      h1:        "We've got it.",
      lede:      "Thanks for telling us what you're thinking. We'll review the details and get back to you to talk it through.",
      steps: [
        'We read through everything you sent us.',
        'We reach out on WhatsApp or email to ask anything we need.',
        'We set up a proper conversation about the idea, materials and timeline.'
      ],
      help:      'In a hurry? Message us on <a href="#">WhatsApp</a> or <a href="#">Instagram</a>.'
    },
    partner: {
      title:     "Application received — Tupsy",
      eyebrow:   'Application received',
      h1:        "We've got it.",
      lede:      "Thanks for applying to open a storefront on Tupsy. We're reviewing your application now and will be in touch soon.",
      steps: [
        'We review your application within 3 working days.',
        "If it's a fit, we reach out on WhatsApp or email to talk next steps.",
        'Once approved, your storefront goes live at weartupsy.com/yourbrand.'
      ],
      help:      'Questions in the meantime? Message us on <a href="#">WhatsApp</a>.'
    }
  };

  var copy = COPY[type] || COPY.project;

  document.title = copy.title;
  document.getElementById('eyebrow').textContent = copy.eyebrow;
  document.getElementById('title').textContent = copy.h1;
  document.getElementById('lede').textContent = copy.lede;
  document.getElementById('help').innerHTML = copy.help;

  var list = document.getElementById('next-list');
  list.innerHTML = copy.steps.map(function (text, i) {
    var num = ('0' + (i + 1)).slice(-2);
    return '<li><b>' + num + '</b><span>' + text + '</span></li>';
  }).join('');

  // Show reference if GAS passed one (project flow only, for now)
  var ref = params.get('ref');
  if (ref) {
    document.getElementById('ref-value').textContent = ref;
    document.getElementById('ref').hidden = false;
  }

  document.getElementById('year').textContent = new Date().getFullYear();
})();
</script>
</body>
</html>
